# ─── Supabase ────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-side only: where the server reaches Supabase when the public URL is not
# reachable from it (containers, D17). Empty means NEXT_PUBLIC_SUPABASE_URL.
# SUPABASE_INTERNAL_URL=http://kong:8000

# ─── Worker (apps/worker, D17) ──────────────────────────────────────
# worker_app role created by migration D17; local stack: see .env.docker.example.
WORKER_DATABASE_URL=postgresql://worker_app:your-password@localhost:54322/postgres
# SMTP adapter (D20): Mailpit of Supabase local ([local_smtp] in supabase/config.toml).
# Resend replaces it in Phase 23.
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
EMAIL_FROM=no-reply@scaliahr.localhost
# Per-tenant exports (D23): absolute path; the backups volume in docker-compose.
BACKUP_DIR=/backups

# ─── Email queue and tenant hosts (D20, D21) ────────────────────────
# Server-only: lib/email enqueues as email_enqueuer (migration D20), which can
# only add email.send jobs.
EMAIL_ENQUEUE_DATABASE_URL=postgresql://email_enqueuer:your-password@localhost:54322/postgres
# Origin of the web app. Tenants live on <slug>.<its host> (D21); the worker
# only sends links to it and its subdomains (D20).
APP_BASE_URL=http://localhost:3000

# ─── Database (Prisma) ──────────────────────────────────────────────
# DATABASE_URL uses the prisma_app role through the Supabase connection pooler.
# Format: prisma_app.<project-ref> as the user, port 6543 for transaction mode.
# The password is set by the db-remote-sync workflow from PRISMA_APP_PASSWORD.
#
# Pool parameters (appended as URL query params):
#   connection_limit  — max connections in the Prisma pool (default: 1 for
#                       serverless/pgBouncer, up to 10 for long-running servers)
#   pool_timeout      — seconds a query waits for a free connection (default: 10)
# Set both explicitly (D37); the Docker stack uses connection_limit=20.
DATABASE_URL=postgresql://prisma_app.jmquwwksfcqswsrkamer:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=20&pool_timeout=10
# DIRECT_URL bypasses the pooler (needed for prisma db pull and migrations).
DIRECT_URL=postgresql://prisma_app.jmquwwksfcqswsrkamer:your-password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ─── Prisma Transaction Tuning ─────────────────────────────────────
# maxWait: ms Prisma waits to acquire a connection for a transaction (default: 5000).
# timeout: ms before an interactive transaction is cancelled and rolled back (default: 10000).
# Raise these only if your queries are legitimately slow (large tenants).
# PRISMA_TX_MAX_WAIT=5000
# PRISMA_TX_TIMEOUT=10000

# ─── Admin DB (privileged, only for lib/jobs/ and lib/admin/) ───────
ADMIN_DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# ─── Auth ────────────────────────────────────────────────────────────
JWT_SECRET=super-secret-jwt-token-change-in-production
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── External Services ──────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key

# ─── Moodle LMS (docker-compose.lms.yml) ────────────────────────────
MOODLE_DB_PASSWORD=change-in-production
MOODLE_BASE_URL=http://localhost:8080
MOODLE_WS_TOKEN=your-moodle-ws-token
