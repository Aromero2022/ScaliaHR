# Local Docker stack (npm run local:up, D17). local-up copies this file to
# .env.docker (git-ignored) the first time. Local values only: never put real
# credentials here.

# What the browser uses to reach Supabase local. Inside the containers the
# server talks to http://kong:8000 instead (see docker-compose.yml).
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
# Public demo anon key of every Supabase local stack; local-up replaces it with
# the value printed by `supabase status`.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Passwords local-up gives the migration-created roles in the LOCAL database.
PRISMA_APP_PASSWORD=prisma_app_local_only
WORKER_APP_PASSWORD=worker_app_local_only

# Host port for the web container (bound to 127.0.0.1 only, D4).
WEB_PORT=3000
