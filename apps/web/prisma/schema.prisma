generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public", "auth"]
}

// ─── MULTI-TENANT CORE ─────────────────────────────────────────────

model Tenant {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  slug       String   @unique
  domain     String?  @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Module provisioning flags (SuccessFactors suite mapping)
  is_ec_active   Boolean @default(false) // Employee Central
  is_pmgm_active Boolean @default(false) // Performance & Goal Management
  is_sdm_active  Boolean @default(false) // Succession & Development Management
  is_rcm_active  Boolean @default(false) // Recruiting Management
  is_lms_active  Boolean @default(false) // Learning Management (Moodle bridge)
  is_onb_active  Boolean @default(false) // Onboarding 2.0
  is_comp_active Boolean @default(false) // Compensation Management
  is_wfa_active  Boolean @default(false) // Workforce Analytics
  is_wfp_active  Boolean @default(false) // Workforce Planning
  is_tme_active  Boolean @default(false) // Time Management
  is_tih_active  Boolean @default(false) // Talent Intelligence Hub

  users                User[]
  departments          Department[]
  job_families         JobFamily[]
  job_roles            JobRole[]
  job_classifications  JobClassification[]
  positions            Position[]
  job_informations     JobInformation[]
  object_definitions   ObjectDefinition[]
  business_rules       BusinessRule[]
  performance_goals    PerformanceGoal[]
  continuous_feedbacks ContinuousFeedback[]
  talent_pools         TalentPool[]
  succession_plans     SuccessionPlan[]

  // TIH (Talent Intelligence Hub)
  skill_ontology        SkillOntology[]
  job_role_skills       JobRoleSkill[]
  employee_skills       EmployeeSkill[]

  // RBP & Admin Center
  permission_groups     PermissionGroup[]
  permission_roles      PermissionRole[]
  role_permissions      RolePermission[]
  role_assignments      RoleAssignment[]
  system_configurations SystemConfiguration[]
  audit_logs            AuditLog[]

  @@map("tenants")
}

// ─── CORE HR: BIZX / EMPLOYEE CENTRAL ──────────────────────────────

model User {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id  String   @db.Uuid
  auth_uid   String?  @unique @db.Uuid
  email      String
  first_name String
  last_name  String
  employee_id String?
  hire_date  DateTime?
  status     EmployeeStatus @default(ACTIVE)

  // REGLA ARCO: soft-delete + anonymization for GDPR/audit trails
  deleted_at     DateTime?
  is_anonymized  Boolean  @default(false)

  // 9-Box matrix fields (Talent & SDM)
  performance_score Float?  @db.DoublePrecision
  potential_score   Float?  @db.DoublePrecision

  // Position Management: hierarchy flows through Position.parent_position_id
  position_id   String? @db.Uuid
  department_id String? @db.Uuid
  job_info_id   String? @db.Uuid

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant       Tenant          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  position     Position?       @relation(fields: [position_id], references: [id], onDelete: SetNull)
  department   Department?     @relation(fields: [department_id], references: [id])
  job_info     JobInformation? @relation(fields: [job_info_id], references: [id])

  authored_feedbacks  ContinuousFeedback[] @relation("FeedbackAuthor")
  received_feedbacks  ContinuousFeedback[] @relation("FeedbackSubject")
  owned_goals         PerformanceGoal[]
  talent_pool_entries TalentPoolEntry[]
  succession_nominees SuccessionNominee[]
  employee_skills     EmployeeSkill[]
  audit_logs          AuditLog[]

  @@unique([tenant_id, email])
  @@index([tenant_id])
  @@index([deleted_at])
  @@index([position_id])
  @@map("users")
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

model Department {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id String  @db.Uuid
  name      String
  code      String?
  parent_id String? @db.Uuid
  cost_center String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant    Tenant      @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  parent    Department? @relation("DeptHierarchy", fields: [parent_id], references: [id])
  children  Department[] @relation("DeptHierarchy")
  users     User[]
  positions Position[]

  @@unique([tenant_id, code])
  @@index([tenant_id])
  @@map("departments")
}

// ─── EC FOUNDATION OBJECTS (Job Profile Builder) ───────────────────

model JobFamily {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id   String @db.Uuid
  family_code String
  name        String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant    Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  job_roles JobRole[]

  @@unique([tenant_id, family_code])
  @@index([tenant_id])
  @@map("job_families")
}

model JobRole {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id     String @db.Uuid
  role_code     String
  name          String
  job_family_id String @db.Uuid

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant              Tenant              @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  job_family          JobFamily           @relation(fields: [job_family_id], references: [id], onDelete: Cascade)
  job_classifications JobClassification[]
  job_role_skills     JobRoleSkill[]

  @@unique([tenant_id, role_code])
  @@index([tenant_id])
  @@index([job_family_id])
  @@map("job_roles")
}

model JobClassification {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id   String @db.Uuid
  job_code    String
  title       String
  pay_grade   String?
  job_role_id String  @db.Uuid

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant           Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  job_role         JobRole          @relation(fields: [job_role_id], references: [id], onDelete: Cascade)
  positions        Position[]
  job_informations JobInformation[]

  @@unique([tenant_id, job_code])
  @@index([tenant_id])
  @@index([job_role_id])
  @@map("job_classifications")
}

// ─── POSITION MANAGEMENT ───────────────────────────────────────────

model Position {
  id                    String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id             String  @db.Uuid
  position_code         String
  title                 String
  fte                   Float   @default(1.0) @db.DoublePrecision
  is_vacant             Boolean @default(true)
  department_id         String? @db.Uuid
  job_classification_id String? @db.Uuid
  parent_position_id    String? @db.Uuid

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant             Tenant             @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  department         Department?        @relation(fields: [department_id], references: [id])
  job_classification JobClassification? @relation(fields: [job_classification_id], references: [id])
  parent_position    Position?          @relation("PositionHierarchy", fields: [parent_position_id], references: [id], onDelete: SetNull)
  child_positions    Position[]         @relation("PositionHierarchy")
  occupants          User[]
  job_informations   JobInformation[]

  @@unique([tenant_id, position_code])
  @@index([tenant_id])
  @@index([parent_position_id])
  @@index([department_id])
  @@map("positions")
}

// ─── JOB INFORMATION (refactored: position-based) ──────────────────

model JobInformation {
  id                    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id             String @db.Uuid
  title                 String
  position_id           String? @db.Uuid
  job_classification_id String? @db.Uuid
  grade                 String?
  pay_band              String?
  salary_min            Float? @db.DoublePrecision
  salary_max            Float? @db.DoublePrecision

  effective_date DateTime @default(now())
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  tenant             Tenant             @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  position           Position?          @relation(fields: [position_id], references: [id], onDelete: SetNull)
  job_classification JobClassification? @relation(fields: [job_classification_id], references: [id], onDelete: SetNull)
  users              User[]

  @@index([tenant_id])
  @@index([position_id])
  @@map("job_informations")
}

// ─── MDF: METADATA FRAMEWORK (Object Definitions) ─────────────────

model ObjectDefinition {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id   String @db.Uuid
  code        String
  label       String
  schema_json Json   @db.JsonB

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, code])
  @@index([tenant_id])
  @@map("object_definitions")
}

// ─── BUSINESS RULES ENGINE ─────────────────────────────────────────

model BusinessRule {
  id                    String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id             String  @db.Uuid
  rule_id               String
  base_object           String
  trigger_event         String
  conditions_actions_json Json   @db.JsonB
  status                Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, rule_id])
  @@index([tenant_id])
  @@index([base_object])
  @@map("business_rules")
}

// ─── TALENT: PERFORMANCE & GOAL MANAGEMENT (PMGM) ──────────────────

model PerformanceGoal {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id  String   @db.Uuid
  user_id    String   @db.Uuid
  title      String
  description String?
  metric     String?
  target_value Float?  @db.DoublePrecision
  actual_value Float?  @db.DoublePrecision
  weight     Float?   @db.DoublePrecision
  status     GoalStatus @default(ON_TRACK)
  due_date   DateTime?
  progress_percentage Int @default(0)
  period_start DateTime
  period_end   DateTime

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([user_id])
  @@map("performance_goals")
}

enum GoalStatus {
  NOT_STARTED
  ON_TRACK
  AT_RISK
  COMPLETED
  CANCELLED
}

model ContinuousFeedback {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id  String   @db.Uuid
  author_id  String   @db.Uuid
  subject_id String   @db.Uuid
  content    String
  visibility FeedbackVisibility @default(PRIVATE)
  category   FeedbackCategory   @default(GENERAL)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant  Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  author  User   @relation("FeedbackAuthor", fields: [author_id], references: [id], onDelete: Cascade)
  subject User   @relation("FeedbackSubject", fields: [subject_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([author_id])
  @@index([subject_id])
  @@map("continuous_feedbacks")
}

enum FeedbackVisibility {
  PRIVATE
  MANAGER_ONLY
  PUBLIC
}

enum FeedbackCategory {
  GENERAL
  RECOGNITION
  COACHING
  DEVELOPMENT
}

// ─── TALENT: SUCCESSION & DEVELOPMENT MANAGEMENT (SDM) ─────────────

model TalentPool {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id String @db.Uuid
  name      String
  description String?
  pool_type TalentPoolType @default(LEADERSHIP)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant  Tenant            @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  entries TalentPoolEntry[]

  @@index([tenant_id])
  @@map("talent_pools")
}

enum TalentPoolType {
  LEADERSHIP
  HIGH_POTENTIAL
  CRITICAL_ROLE
  EMERGING_TALENT
  CUSTOM
}

model TalentPoolEntry {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  talent_pool_id String   @db.Uuid
  user_id        String   @db.Uuid
  readiness      ReadinessLevel @default(NOT_READY)
  notes          String?

  added_at   DateTime @default(now())
  updated_at DateTime @updatedAt

  talent_pool TalentPool @relation(fields: [talent_pool_id], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([talent_pool_id, user_id])
  @@map("talent_pool_entries")
}

enum ReadinessLevel {
  READY_NOW
  READY_1_YEAR
  READY_2_YEARS
  NOT_READY
}

model SuccessionPlan {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id   String @db.Uuid
  position_title String
  department     String?
  criticality    PlanCriticality @default(MEDIUM)
  status         PlanStatus      @default(DRAFT)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant   Tenant              @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  nominees SuccessionNominee[]

  @@index([tenant_id])
  @@map("succession_plans")
}

enum PlanCriticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model SuccessionNominee {
  id                 String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  succession_plan_id String @db.Uuid
  user_id            String @db.Uuid
  readiness          ReadinessLevel @default(NOT_READY)
  ranking            Int?
  notes              String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  succession_plan SuccessionPlan @relation(fields: [succession_plan_id], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([succession_plan_id, user_id])
  @@map("succession_nominees")
}

// ─── TALENT INTELLIGENCE HUB (TIH) ────────────────────────────────

model SkillOntology {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id   String       @db.Uuid
  code        String
  name        String
  description String?
  category    SkillCategory @default(TECHNICAL)
  is_active   Boolean      @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant          Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  job_role_skills JobRoleSkill[]
  employee_skills EmployeeSkill[]

  @@unique([tenant_id, code])
  @@index([tenant_id])
  @@index([category])
  @@map("skill_ontology")
}

enum SkillCategory {
  TECHNICAL
  LEADERSHIP
  FUNCTIONAL
  INTERPERSONAL
  LANGUAGE
  CERTIFICATION
}

model JobRoleSkill {
  id               String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id        String @db.Uuid
  job_role_id      String @db.Uuid
  skill_id         String @db.Uuid
  required_level   Int    @default(3)
  importance       SkillImportance @default(REQUIRED)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant   Tenant        @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  job_role JobRole       @relation(fields: [job_role_id], references: [id], onDelete: Cascade)
  skill    SkillOntology @relation(fields: [skill_id], references: [id], onDelete: Cascade)

  @@unique([job_role_id, skill_id])
  @@index([tenant_id])
  @@index([job_role_id])
  @@index([skill_id])
  @@map("job_role_skills")
}

enum SkillImportance {
  CRITICAL
  REQUIRED
  PREFERRED
  NICE_TO_HAVE
}

model EmployeeSkill {
  id                  String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id           String @db.Uuid
  user_id             String @db.Uuid
  skill_id            String @db.Uuid
  self_assessed_level Int    @default(1)
  manager_assessed_level Int?
  verified            Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant Tenant        @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  skill  SkillOntology @relation(fields: [skill_id], references: [id], onDelete: Cascade)

  @@unique([user_id, skill_id])
  @@index([tenant_id])
  @@index([user_id])
  @@index([skill_id])
  @@map("employee_skills")
}

// ─── ROLE-BASED PERMISSIONS (RBP) ──────────────────────────────────

model PermissionGroup {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id     String @db.Uuid
  name          String
  description   String?
  criteria_json Json?  @db.JsonB

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant               Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  granted_assignments  RoleAssignment[] @relation("GrantedGroup")
  target_assignments   RoleAssignment[] @relation("TargetPopulation")

  @@unique([tenant_id, name])
  @@index([tenant_id])
  @@map("permission_groups")
}

model PermissionRole {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id     String  @db.Uuid
  name          String
  description   String?
  is_admin_role Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant           Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  role_permissions RolePermission[]
  role_assignments RoleAssignment[]

  @@unique([tenant_id, name])
  @@index([tenant_id])
  @@map("permission_roles")
}

model RolePermission {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id       String @db.Uuid
  role_id         String @db.Uuid
  permission_name String

  created_at DateTime @default(now())

  tenant Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  role   PermissionRole @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([role_id, permission_name])
  @@index([tenant_id])
  @@index([role_id])
  @@map("role_permissions")
}

model RoleAssignment {
  id                         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id                  String @db.Uuid
  role_id                    String @db.Uuid
  granted_group_id           String @db.Uuid
  target_population_group_id String @db.Uuid

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant           Tenant          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  role             PermissionRole  @relation(fields: [role_id], references: [id], onDelete: Cascade)
  granted_group    PermissionGroup @relation("GrantedGroup", fields: [granted_group_id], references: [id], onDelete: Cascade)
  target_population PermissionGroup @relation("TargetPopulation", fields: [target_population_group_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([role_id])
  @@map("role_assignments")
}

// ─── ADMIN CENTER / PLATFORM ───────────────────────────────────────

model SystemConfiguration {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id String @db.Uuid
  key       String
  value_json Json  @db.JsonB

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, key])
  @@index([tenant_id])
  @@map("system_configurations")
}

model AuditLog {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id    String @db.Uuid
  user_id      String @db.Uuid
  action       String
  details_json Json?  @db.JsonB

  created_at DateTime @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([user_id])
  @@index([action])
  @@index([created_at])
  @@map("audit_logs")
}
