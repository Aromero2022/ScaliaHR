generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["auth", "public"]
}

model Tenant {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                    String
  slug                    String                    @unique
  domain                  String?                   @unique
  created_at              DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at              DateTime                  @default(now()) @updatedAt @db.Timestamptz(6)
  is_ec_active            Boolean                   @default(false)
  is_pmgm_active          Boolean                   @default(false)
  is_sdm_active           Boolean                   @default(false)
  is_rcm_active           Boolean                   @default(false)
  is_lms_active           Boolean                   @default(false)
  is_onb_active           Boolean                   @default(false)
  is_comp_active          Boolean                   @default(false)
  is_wfa_active           Boolean                   @default(false)
  is_wfp_active           Boolean                   @default(false)
  is_tme_active           Boolean                   @default(false)
  is_tih_active           Boolean                   @default(false)
  is_pos_mgmt_active      Boolean                   @default(false)
  arco_requests           arco_requests[]
  audit_logs              AuditLog[]
  business_rules          BusinessRule[]
  business_units          business_units[]
  continuous_feedbacks    ContinuousFeedback[]
  departments             Department[]
  ec_compensation         ec_compensation[]
  ec_job_information      ec_job_information[]
  ec_personal_information ec_personal_information[]
  employee_skills         EmployeeSkill[]
  group_members           group_members[]
  job_classifications     JobClassification[]
  job_families            JobFamily[]
  job_informations        JobInformation[]
  job_role_skills         JobRoleSkill[]
  job_roles               JobRole[]
  legal_entities          legal_entities[]
  lms_tenant_map          lms_tenant_map?
  lms_user_map            lms_user_map[]
  locations               locations[]
  object_definitions      ObjectDefinition[]
  performance_goals       PerformanceGoal[]
  permission_groups       PermissionGroup[]
  permission_roles        PermissionRole[]
  positions               Position[]
  role_grants             role_grants[]
  role_permissions        RolePermission[]
  skill_ontology          SkillOntology[]
  succession_plans        SuccessionPlan[]
  system_configurations   SystemConfiguration[]
  talent_pools            TalentPool[]
  user_settings           user_settings[]
  user_tenant_memberships user_tenant_memberships[]
  users                   User[]

  @@map("tenants")
  @@schema("public")
}

model User {
  id                                                         String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id                                                  String                    @db.Uuid
  auth_uid                                                   String?                   @unique @db.Uuid
  email                                                      String
  first_name                                                 String
  last_name                                                  String
  employee_id                                                String?
  hire_date                                                  DateTime?                 @db.Timestamptz(6)
  status                                                     EmployeeStatus            @default(ACTIVE)
  deleted_at                                                 DateTime?                 @db.Timestamptz(6)
  is_anonymized                                              Boolean                   @default(false)
  performance_score                                          Float?
  potential_score                                            Float?
  department_id                                              String?                   @db.Uuid
  job_info_id                                                String?                   @db.Uuid
  created_at                                                 DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at                                                 DateTime                  @default(now()) @updatedAt @db.Timestamptz(6)
  position_id                                                String?                   @db.Uuid
  arco_requests_arco_requests_requester_idTousers            arco_requests[]           @relation("arco_requests_requester_idTousers")
  arco_requests_arco_requests_subject_idTousers              arco_requests[]           @relation("arco_requests_subject_idTousers")
  audit_logs                                                 AuditLog[]
  authored_feedbacks                                         ContinuousFeedback[]      @relation("FeedbackAuthor")
  received_feedbacks                                         ContinuousFeedback[]      @relation("FeedbackSubject")
  ec_compensation                                            ec_compensation[]
  ec_job_information_ec_job_information_manager_idTousers    ec_job_information[]      @relation("ec_job_information_manager_idTousers")
  ec_job_information_ec_job_information_user_idTousers       ec_job_information[]      @relation("ec_job_information_user_idTousers")
  ec_personal_information                                    ec_personal_information[]
  employee_skills_employee_skills_manager_assessed_byTousers EmployeeSkill[]           @relation("employee_skills_manager_assessed_byTousers")
  employee_skills_employee_skills_tenant_id_user_idTousers   EmployeeSkill[]           @relation("employee_skills_tenant_id_user_idTousers")
  group_members                                              group_members[]
  lms_user_map                                               lms_user_map[]
  owned_goals                                                PerformanceGoal[]
  succession_nominees                                        SuccessionNominee[]
  talent_pool_entries                                        TalentPoolEntry[]
  department                                                 Department?               @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  job_info                                                   JobInformation?           @relation(fields: [job_info_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  position                                                   Position?                 @relation(fields: [position_id], references: [id], onUpdate: NoAction)
  tenant                                                     Tenant                    @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenant_id, email])
  @@unique([tenant_id, id], map: "users_tenant_id_uniq")
  @@index([deleted_at], map: "idx_users_deleted_at")
  @@index([position_id], map: "idx_users_position")
  @@index([tenant_id], map: "idx_users_tenant")
  @@map("users")
  @@schema("public")
}

model Department {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id          String               @db.Uuid
  name               String
  code               String?
  parent_id          String?              @db.Uuid
  cost_center        String?
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
  legal_entity_id    String?              @db.Uuid
  business_unit_id   String?              @db.Uuid
  location_id        String?              @db.Uuid
  business_units     business_units?      @relation(fields: [business_unit_id], references: [id], onUpdate: NoAction)
  legal_entities     legal_entities?      @relation(fields: [legal_entity_id], references: [id], onUpdate: NoAction)
  locations          locations?           @relation(fields: [location_id], references: [id], onUpdate: NoAction)
  parent             Department?          @relation("DeptHierarchy", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children           Department[]         @relation("DeptHierarchy")
  tenant             Tenant               @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ec_job_information ec_job_information[]
  positions          Position[]
  users              User[]

  @@unique([tenant_id, code])
  @@index([business_unit_id], map: "idx_departments_business_unit")
  @@index([legal_entity_id], map: "idx_departments_legal_entity")
  @@index([location_id], map: "idx_departments_location")
  @@index([tenant_id], map: "idx_departments_tenant")
  @@map("departments")
  @@schema("public")
}

model JobFamily {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id   String    @db.Uuid
  family_code String
  name        String
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  tenant      Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  job_roles   JobRole[]

  @@unique([tenant_id, family_code])
  @@index([tenant_id], map: "idx_job_families_tenant")
  @@map("job_families")
  @@schema("public")
}

model JobRole {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id           String              @db.Uuid
  role_code           String
  name                String
  job_family_id       String              @db.Uuid
  created_at          DateTime            @default(now()) @db.Timestamptz(6)
  updated_at          DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  job_classifications JobClassification[]
  job_role_skills     JobRoleSkill[]
  job_family          JobFamily           @relation(fields: [job_family_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tenant              Tenant              @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenant_id, role_code])
  @@unique([tenant_id, id], map: "job_roles_tenant_id_uniq")
  @@index([job_family_id], map: "idx_job_roles_family")
  @@index([tenant_id], map: "idx_job_roles_tenant")
  @@map("job_roles")
  @@schema("public")
}

model JobClassification {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id          String               @db.Uuid
  job_code           String
  title              String
  pay_grade          String?
  job_role_id        String               @db.Uuid
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
  ec_job_information ec_job_information[]
  job_role           JobRole              @relation(fields: [job_role_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tenant             Tenant               @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  job_informations   JobInformation[]
  positions          Position[]

  @@unique([tenant_id, job_code])
  @@index([job_role_id], map: "idx_job_classifications_role")
  @@index([tenant_id], map: "idx_job_classifications_tenant")
  @@map("job_classifications")
  @@schema("public")
}

model Position {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id             String               @db.Uuid
  position_code         String
  title                 String
  fte                   Float                @default(1.0)
  is_vacant             Boolean              @default(true)
  department_id         String?              @db.Uuid
  job_classification_id String?              @db.Uuid
  parent_position_id    String?              @db.Uuid
  created_at            DateTime             @default(now()) @db.Timestamptz(6)
  updated_at            DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
  ec_job_information    ec_job_information[]
  job_informations      JobInformation[]
  department            Department?          @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  job_classification    JobClassification?   @relation(fields: [job_classification_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parent_position       Position?            @relation("PositionHierarchy", fields: [parent_position_id], references: [id], onUpdate: NoAction)
  child_positions       Position[]           @relation("PositionHierarchy")
  tenant                Tenant               @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  occupants             User[]

  @@unique([tenant_id, position_code])
  @@index([department_id], map: "idx_positions_department")
  @@index([parent_position_id], map: "idx_positions_parent")
  @@index([tenant_id], map: "idx_positions_tenant")
  @@map("positions")
  @@schema("public")
}

model JobInformation {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id             String             @db.Uuid
  title                 String
  grade                 String?
  pay_band              String?
  salary_min            Float?
  salary_max            Float?
  effective_date        DateTime           @default(now()) @db.Timestamptz(6)
  created_at            DateTime           @default(now()) @db.Timestamptz(6)
  updated_at            DateTime           @default(now()) @updatedAt @db.Timestamptz(6)
  position_id           String?            @db.Uuid
  job_classification_id String?            @db.Uuid
  job_classification    JobClassification? @relation(fields: [job_classification_id], references: [id], onUpdate: NoAction)
  position              Position?          @relation(fields: [position_id], references: [id], onUpdate: NoAction)
  tenant                Tenant             @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                 User[]

  @@index([position_id], map: "idx_job_informations_position")
  @@index([tenant_id], map: "idx_job_informations_tenant")
  @@map("job_informations")
  @@schema("public")
}

model ObjectDefinition {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id   String   @db.Uuid
  code        String
  label       String
  schema_json Json     @default("{}")
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  tenant      Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenant_id, code])
  @@index([tenant_id], map: "idx_object_definitions_tenant")
  @@map("object_definitions")
  @@schema("public")
}

model BusinessRule {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id               String   @db.Uuid
  rule_id                 String
  base_object             String
  trigger_event           String
  conditions_actions_json Json     @default("{}")
  status                  Boolean  @default(true)
  created_at              DateTime @default(now()) @db.Timestamptz(6)
  updated_at              DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  tenant                  Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenant_id, rule_id])
  @@index([base_object], map: "idx_business_rules_base_object")
  @@index([tenant_id], map: "idx_business_rules_tenant")
  @@map("business_rules")
  @@schema("public")
}

model PerformanceGoal {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id           String     @db.Uuid
  user_id             String     @db.Uuid
  title               String
  description         String?
  metric              String?
  target_value        Float?
  actual_value        Float?
  weight              Float?
  status              GoalStatus @default(ON_TRACK)
  due_date            DateTime?  @db.Timestamptz(6)
  progress_percentage Int        @default(0)
  period_start        DateTime   @db.Timestamptz(6)
  period_end          DateTime   @db.Timestamptz(6)
  created_at          DateTime   @default(now()) @db.Timestamptz(6)
  updated_at          DateTime   @default(now()) @updatedAt @db.Timestamptz(6)
  tenant              Tenant     @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user                User       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenant_id], map: "idx_performance_goals_tenant")
  @@index([user_id], map: "idx_performance_goals_user")
  @@map("performance_goals")
  @@schema("public")
}

model ContinuousFeedback {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id  String             @db.Uuid
  author_id  String             @db.Uuid
  subject_id String             @db.Uuid
  content    String
  visibility FeedbackVisibility @default(PRIVATE)
  category   FeedbackCategory   @default(GENERAL)
  created_at DateTime           @default(now()) @db.Timestamptz(6)
  updated_at DateTime           @default(now()) @updatedAt @db.Timestamptz(6)
  author     User               @relation("FeedbackAuthor", fields: [author_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subject    User               @relation("FeedbackSubject", fields: [subject_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tenant     Tenant             @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([author_id], map: "idx_continuous_feedbacks_author")
  @@index([subject_id], map: "idx_continuous_feedbacks_subject")
  @@index([tenant_id], map: "idx_continuous_feedbacks_tenant")
  @@map("continuous_feedbacks")
  @@schema("public")
}

model TalentPool {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id   String            @db.Uuid
  name        String
  description String?
  pool_type   TalentPoolType    @default(LEADERSHIP)
  created_at  DateTime          @default(now()) @db.Timestamptz(6)
  updated_at  DateTime          @default(now()) @updatedAt @db.Timestamptz(6)
  entries     TalentPoolEntry[]
  tenant      Tenant            @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenant_id], map: "idx_talent_pools_tenant")
  @@map("talent_pools")
  @@schema("public")
}

model TalentPoolEntry {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  talent_pool_id String         @db.Uuid
  user_id        String         @db.Uuid
  readiness      ReadinessLevel @default(NOT_READY)
  notes          String?
  added_at       DateTime       @default(now()) @db.Timestamptz(6)
  updated_at     DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  talent_pool    TalentPool     @relation(fields: [talent_pool_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user           User           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([talent_pool_id, user_id])
  @@map("talent_pool_entries")
  @@schema("public")
}

model SuccessionPlan {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id      String              @db.Uuid
  position_title String
  department     String?
  criticality    PlanCriticality     @default(MEDIUM)
  status         PlanStatus          @default(DRAFT)
  created_at     DateTime            @default(now()) @db.Timestamptz(6)
  updated_at     DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  nominees       SuccessionNominee[]
  tenant         Tenant              @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenant_id], map: "idx_succession_plans_tenant")
  @@map("succession_plans")
  @@schema("public")
}

model SuccessionNominee {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  succession_plan_id String         @db.Uuid
  user_id            String         @db.Uuid
  readiness          ReadinessLevel @default(NOT_READY)
  ranking            Int?
  notes              String?
  created_at         DateTime       @default(now()) @db.Timestamptz(6)
  updated_at         DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  succession_plan    SuccessionPlan @relation(fields: [succession_plan_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user               User           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([succession_plan_id, user_id])
  @@map("succession_nominees")
  @@schema("public")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model SkillOntology {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id       String          @db.Uuid
  code            String
  name            String
  description     String?
  category        String          @default("technical")
  is_active       Boolean         @default(true)
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  updated_at      DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  employee_skills EmployeeSkill[]
  job_role_skills JobRoleSkill[]
  tenant          Tenant          @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenant_id, code])
  @@unique([tenant_id, id], map: "skill_ontology_tenant_id_uniq")
  @@index([category], map: "idx_skill_ontology_category")
  @@index([tenant_id], map: "idx_skill_ontology_tenant")
  @@map("skill_ontology")
  @@schema("public")
}

model JobRoleSkill {
  tenant_id                  String        @db.Uuid
  job_role_id                String        @db.Uuid
  skill_id                   String        @db.Uuid
  required_proficiency_level Int           @default(3) @db.SmallInt
  created_at                 DateTime      @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime      @default(now()) @updatedAt @db.Timestamptz(6)
  job_roles                  JobRole       @relation(fields: [tenant_id, job_role_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: NoAction, map: "jrs_job_role_fk")
  skill_ontology             SkillOntology @relation(fields: [tenant_id, skill_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: NoAction, map: "jrs_skill_fk")
  tenant                     Tenant        @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "jrs_tenant_fk")

  @@id([tenant_id, job_role_id, skill_id])
  @@index([job_role_id], map: "idx_job_role_skills_role")
  @@index([skill_id], map: "idx_job_role_skills_skill")
  @@index([tenant_id], map: "idx_job_role_skills_tenant")
  @@map("job_role_skills")
  @@schema("public")
}

model EmployeeSkill {
  tenant_id                                        String        @db.Uuid
  user_id                                          String        @db.Uuid
  skill_id                                         String        @db.Uuid
  self_assessed_level                              Int           @default(1) @db.SmallInt
  manager_assessed_level                           Int?          @db.SmallInt
  created_at                                       DateTime      @default(now()) @db.Timestamptz(6)
  updated_at                                       DateTime      @default(now()) @updatedAt @db.Timestamptz(6)
  self_assessed_at                                 DateTime?     @db.Timestamptz(6)
  manager_assessed_at                              DateTime?     @db.Timestamptz(6)
  manager_assessed_by                              String?       @db.Uuid
  users_employee_skills_manager_assessed_byTousers User?         @relation("employee_skills_manager_assessed_byTousers", fields: [manager_assessed_by], references: [id], onUpdate: NoAction, map: "es_manager_fk")
  skill_ontology                                   SkillOntology @relation(fields: [tenant_id, skill_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: NoAction, map: "es_skill_fk")
  tenant                                           Tenant        @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "es_tenant_fk")
  users_employee_skills_tenant_id_user_idTousers   User          @relation("employee_skills_tenant_id_user_idTousers", fields: [tenant_id, user_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: NoAction, map: "es_user_fk")

  @@id([tenant_id, user_id, skill_id])
  @@index([skill_id], map: "idx_employee_skills_skill")
  @@index([tenant_id], map: "idx_employee_skills_tenant")
  @@index([user_id], map: "idx_employee_skills_user")
  @@map("employee_skills")
  @@schema("public")
}

model PermissionGroup {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id     String          @db.Uuid
  name          String
  description   String?
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  updated_at    DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  group_members group_members[]
  tenant        Tenant          @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  role_grants   role_grants[]

  @@unique([tenant_id, name])
  @@index([tenant_id], map: "idx_permission_groups_tenant")
  @@map("permission_groups")
  @@schema("public")
}

model PermissionRole {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id        String           @db.Uuid
  name             String
  description      String?
  is_admin_role    Boolean          @default(false)
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
