{
  "name": "scaliahr",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "dev:web": "turbo dev --filter=@scaliahr/web",
    "dev:mobile": "turbo dev --filter=@scaliahr/mobile",
    "db:generate": "turbo db:generate",
    "db:sync": "turbo db:sync",
    "check:forbidden": "bash scripts/check-forbidden.sh"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,yml,yaml,md,sql,sh,toml}": [
      "bash scripts/check-forbidden.sh"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.0",
    "lint-staged": "^15.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "turbo": "^2.5.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "npm@10.9.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aromero2022/ScaliaHR.git"
  }
}
