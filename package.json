{
  "name": "scaliahr",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "dev:web": "turbo dev --filter=@scaliahr/web",
    "dev:mobile": "turbo dev --filter=@scaliahr/mobile",
    "db:generate": "turbo db:generate",
    "db:sync": "turbo db:sync",
    "db:advisors": "node scripts/check-advisors.mjs",
    "check:forbidden": "bash scripts/check-forbidden.sh",
    "check:secrets": "docker run --rm -v \"$PWD:/repo\" -w /repo ghcr.io/gitleaks/gitleaks@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f git --redact --no-banner --config .gitleaks.toml --exit-code 1 .",
    "check:prod-build": "node scripts/check-prod-build.mjs apps/web/.next",
    "local:up": "bash scripts/local-up.sh",
    "local:down": "bash scripts/local-down.sh",
    "local:rollback": "bash scripts/local-up.sh --rollback",
    "load:test": "bash scripts/load-test.sh",
    "backup:full": "bash scripts/backup-full.sh",
    "restore:full": "bash scripts/restore-full.sh",
    "restore:tenant": "node scripts/restore-tenant.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,yml,yaml,md,sql,sh,toml}": [
      "bash scripts/check-forbidden.sh"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.0",
    "lint-staged": "^15.4.0",
    "otplib": "^13.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "turbo": "^2.5.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "npm@10.9.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aromero2022/ScaliaHR.git"
  }
}
